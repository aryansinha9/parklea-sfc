# Supabase project credentials (Dashboard → Project Settings → API)
# The anon key is safe to expose publicly — writes are blocked by row-level security.
# Copy this file to .env for local dev, and add the same two variables in
# Vercel → Project → Settings → Environment Variables, then redeploy.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web3Forms access key (https://web3forms.com → the key emailed to you on signup).
# Powers the contact form, the sponsorship enquiry form and the newsletter signup
# in the footer. OPTIONAL — the club's live key is committed in parklea-site/js/
# forms.js, so the forms work with no configuration. Set this only to point the
# forms at a different key (a new inbox, or a throwaway key for testing) without
# editing code; it overrides the committed one.
# VITE_WEB3FORMS_KEY=
